<Project>
  <!-- houseCARL, pinned as the submodule external/houseCARL: its core, nexus, generator and server are built from there. -->
  <PropertyGroup>
    <HousecarlRoot>$(MSBuildThisFileDirectory)external\houseCARL\</HousecarlRoot>
    <HousecarlSrc>$(HousecarlRoot)src\</HousecarlSrc>
    <!-- SkyWright's own libraries: SkyWright.Engine (the geometry and reach code its probes share) and its tests. -->
    <SkyWrightSrc>$(MSBuildThisFileDirectory)src\</SkyWrightSrc>
    <!-- The SkyRender package version every program builds on. A build can override it (for example
         -p:SkyRenderVersion=4.1.0-cutouttint.2 to test a prerelease from a local feed). -->
    <SkyRenderVersion Condition="'$(SkyRenderVersion)' == ''">4.0.0</SkyRenderVersion>
    <!-- The see-through fill and the tint that follows a leaf card's cut-out exist from SkyRender 4.1. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1'))">$(DefineConstants);SKYRENDER_CUTOUT_TINT</DefineConstants>
    <!-- Distant LOD on a live scene (LiveDistantLod, a draw-time cut) exists from SkyRender 4.1, but not in the 4.1
         prerelease made for the tint alone. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1')) and !$(SkyRenderVersion.Contains('cutouttint'))">$(DefineConstants);SKYRENDER_LIVE_LOD</DefineConstants>
    <!-- The sky (dome, clouds, sun, moons, stars: GlRenderer.Sky) exists from SkyRender 4.1, but not in its first two
         prereleases. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1')) and !$(SkyRenderVersion.Contains('cutouttint')) and !$(SkyRenderVersion.EndsWith('livelod.1'))">$(DefineConstants);SKYRENDER_SKY</DefineConstants>
  </PropertyGroup>

  <!-- The build layout, one folder per configuration: bin\<Configuration>\<the app's .NET version>\ holds SkyWright.exe,
       Probes\<name>\ (every program SkyWright runs), Tools\<name>\ (runcontrol, houseCARL's server and its rulebook),
       Data\ and Tests\. This file is the ONE owner of where each program goes; the SkyWrightLayout target below writes
       the same names into skywright-layout.json, which the programs (CheckoutLayout.cs) and the Python tools
       (_geometry-harness/buildlayout.py) read instead of spelling a path. houseCARL's own projects keep their output. -->
  <PropertyGroup>
    <SkyWrightConfiguration>$(Configuration)</SkyWrightConfiguration>
    <SkyWrightConfiguration Condition="'$(SkyWrightConfiguration)' == ''">Debug</SkyWrightConfiguration>
    <SkyWrightFramework>net9.0-windows10.0.19041.0</SkyWrightFramework>
    <SkyWrightLayoutRoot>$(MSBuildThisFileDirectory)bin\$(SkyWrightConfiguration)\$(SkyWrightFramework)\</SkyWrightLayoutRoot>
    <SkyWrightProbes>Probes</SkyWrightProbes>
    <SkyWrightTools>Tools</SkyWrightTools>
    <SkyWrightData>Data</SkyWrightData>
    <SkyWrightLayoutMarker>skywright-layout.json</SkyWrightLayoutMarker>
    <_SwHarness>$(MSBuildThisFileDirectory)_geometry-harness\</_SwHarness>
    <_SwInHarness>$([System.String]::Copy('$(MSBuildProjectDirectory)\').ToUpperInvariant().StartsWith($(_SwHarness.ToUpperInvariant())))</_SwInHarness>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SwInHarness)' == 'True'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <_SwFolder>$(SkyWrightProbes)\$(MSBuildProjectName)\</_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'workbench'"></_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'runcontrol'">$(SkyWrightTools)\runcontrol\</_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'workbench.tests'">Tests\workbench.tests\</_SwFolder>
    <OutputPath>$(SkyWrightLayoutRoot)$(_SwFolder)</OutputPath>
  </PropertyGroup>
  <!-- The engine's tests go beside the app's, in Tests\<name>\. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SkyWright.Engine.Tests'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(SkyWrightLayoutRoot)Tests\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>

  <!-- After the app builds: houseCARL's server and its rulebook into Tools\housecarl-mcp\, the app data into Data\, and
       the marker that names the layout. The app's project references the server project so it is built first. -->
  <Target Name="SkyWrightLayout" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'workbench'">
    <PropertyGroup>
      <_SwCorpus>$(HousecarlRoot)generated\corpus.json</_SwCorpus>
      <_SwScenePolicy>$(HousecarlRoot).claude\skills\evaluation-reporting\references\scene-policy.json</_SwScenePolicy>
      <_SwJson>{ "kind": "skywright-build", "configuration": "$(SkyWrightConfiguration)", "framework": "$(SkyWrightFramework)", "app": "SkyWright.exe", "program": "$(SkyWrightProbes)/{name}/{name}.exe", "tool": "$(SkyWrightTools)/{name}/{name}.exe", "tools": ["runcontrol", "housecarl-mcp"], "server": "$(SkyWrightTools)/housecarl-mcp/housecarl-mcp.exe", "corpus": "$(SkyWrightTools)/housecarl-mcp/corpus.json", "registry": "$(SkyWrightData)/check-registry.json", "severity": "$(SkyWrightData)/workbench-severity.json", "scenePolicy": "$(SkyWrightData)/scene-policy.json" }</_SwJson>
    </PropertyGroup>
    <MSBuild Projects="$(HousecarlSrc)housecarl-mcp\housecarl-mcp.csproj" Targets="GetTargetPath" Properties="Configuration=$(SkyWrightConfiguration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_SwServerDll" />
    </MSBuild>
    <PropertyGroup>
      <_SwServerOut>$([System.IO.Path]::GetDirectoryName($(_SwServerDll)))\</_SwServerOut>
    </PropertyGroup>
    <ItemGroup>
      <_SwServerFiles Include="$(_SwServerOut)**\*" />
      <_SwDataFiles Include="$(MSBuildThisFileDirectory)data\*" />
    </ItemGroup>
    <Error Condition="'$([System.IO.Path]::GetFullPath($(OutDir)))' != '$([System.IO.Path]::GetFullPath($(SkyWrightLayoutRoot)))'" Text="the app was built to $(OutDir), but SkyWright's layout is $(SkyWrightLayoutRoot); build without -o or OutputPath (scripts\build.ps1), so the app, its programs and its marker stay together." />
    <Error Condition="'@(_SwServerFiles)' == ''" Text="houseCARL's server is not built at $(_SwServerOut); build the solution (it builds the server first)." />
    <Copy SourceFiles="@(_SwServerFiles)" DestinationFiles="@(_SwServerFiles->'$(SkyWrightLayoutRoot)$(SkyWrightTools)\housecarl-mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Warning Condition="!Exists('$(_SwCorpus)')" Text="the rulebook $(_SwCorpus) is missing, so SkyWright cannot write patches; run scripts\build.ps1, which makes it." />
    <Delete Condition="!Exists('$(_SwCorpus)')" Files="$(SkyWrightLayoutRoot)$(SkyWrightTools)\housecarl-mcp\corpus.json" />
    <Copy Condition="Exists('$(_SwCorpus)')" SourceFiles="$(_SwCorpus)" DestinationFolder="$(SkyWrightLayoutRoot)$(SkyWrightTools)\housecarl-mcp\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SwDataFiles)" DestinationFolder="$(SkyWrightLayoutRoot)$(SkyWrightData)\" SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(_SwScenePolicy)')" SourceFiles="$(_SwScenePolicy)" DestinationFolder="$(SkyWrightLayoutRoot)$(SkyWrightData)\" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(SkyWrightLayoutRoot)$(SkyWrightLayoutMarker)" Lines="$(_SwJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
