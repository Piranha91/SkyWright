<Project>
  <!-- houseCARL, pinned as the submodule external/houseCARL: its core, nexus, generator and server are built from there. -->
  <PropertyGroup>
    <HousecarlRoot>$(MSBuildThisFileDirectory)external\houseCARL\</HousecarlRoot>
    <HousecarlSrc>$(HousecarlRoot)src\</HousecarlSrc>
    <!-- SkyWright's own libraries: SkyWright.Engine (the geometry and reach code its probes share) and its tests. -->
    <SkyWrightSrc>$(MSBuildThisFileDirectory)src\</SkyWrightSrc>
    <!-- The SkyRender package version every program builds on. A build can override it (for example
         -p:SkyRenderVersion=4.1.0-cutouttint.2 to test a prerelease from a local feed). -->
    <SkyRenderVersion Condition="'$(SkyRenderVersion)' == ''">4.0.0</SkyRenderVersion>
    <!-- The see-through fill and the tint that follows a leaf card's cut-out exist from SkyRender 4.1. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1'))">$(DefineConstants);SKYRENDER_CUTOUT_TINT</DefineConstants>
    <!-- Distant LOD on a live scene (LiveDistantLod, a draw-time cut) exists from SkyRender 4.1, but not in the 4.1
         prerelease made for the tint alone. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1')) and !$(SkyRenderVersion.Contains('cutouttint'))">$(DefineConstants);SKYRENDER_LIVE_LOD</DefineConstants>
    <!-- The sky (dome, clouds, sun, moons, stars: GlRenderer.Sky) exists from SkyRender 4.1, but not in its first two
         prereleases. -->
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(SkyRenderVersion.Split(`-`)[0])', '4.1')) and !$(SkyRenderVersion.Contains('cutouttint')) and !$(SkyRenderVersion.EndsWith('livelod.1'))">$(DefineConstants);SKYRENDER_SKY</DefineConstants>
  </PropertyGroup>

  <!-- The build layout, one folder per configuration: bin\<Configuration>\<the app's .NET version>\ holds SkyWright.exe,
       Probes\<name>\ (every program SkyWright runs), Tools\<name>\ (runcontrol, the guards), Data\ (with houseCARL's
       rulebook) and Tests\. This file is the ONE owner of where each program goes; the SkyWrightLayout target below writes
       the same names into skywright-layout.json, which the programs (CheckoutLayout.cs) and the Python tools
       (_geometry-harness/buildlayout.py) read instead of spelling a path. houseCARL's own projects keep their output. -->
  <PropertyGroup>
    <SkyWrightConfiguration>$(Configuration)</SkyWrightConfiguration>
    <SkyWrightConfiguration Condition="'$(SkyWrightConfiguration)' == ''">Debug</SkyWrightConfiguration>
    <SkyWrightFramework>net9.0-windows10.0.19041.0</SkyWrightFramework>
    <SkyWrightLayoutRoot>$(MSBuildThisFileDirectory)bin\$(SkyWrightConfiguration)\$(SkyWrightFramework)\</SkyWrightLayoutRoot>
    <SkyWrightProbes>Probes</SkyWrightProbes>
    <SkyWrightTools>Tools</SkyWrightTools>
    <SkyWrightData>Data</SkyWrightData>
    <SkyWrightLayoutMarker>skywright-layout.json</SkyWrightLayoutMarker>
    <_SwHarness>$(MSBuildThisFileDirectory)_geometry-harness\</_SwHarness>
    <_SwInHarness>$([System.String]::Copy('$(MSBuildProjectDirectory)\').ToUpperInvariant().StartsWith($(_SwHarness.ToUpperInvariant())))</_SwInHarness>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SwInHarness)' == 'True'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <_SwFolder>$(SkyWrightProbes)\$(MSBuildProjectName)\</_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'workbench'"></_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'runcontrol'">$(SkyWrightTools)\runcontrol\</_SwFolder>
    <_SwFolder Condition="'$(MSBuildProjectName)' == 'workbench.tests'">Tests\workbench.tests\</_SwFolder>
    <OutputPath>$(SkyWrightLayoutRoot)$(_SwFolder)</OutputPath>
  </PropertyGroup>
  <!-- The engine's tests go beside the app's, in Tests\<name>\. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SkyWright.Engine.Tests'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(SkyWrightLayoutRoot)Tests\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>
  <!-- The guards run the probes of the build they sit in, so they sit in it, as a tool. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SkyWright.Guards'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(SkyWrightLayoutRoot)$(SkyWrightTools)\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>

  <!-- houseCARL's server code as a library, for a project that sets SkyWrightHousecarlLibrary: its built assembly is
       referenced by the path houseCARL's project reports, so only housecarl-mcp.dll (and what it references) is copied,
       never its program. The project also keeps a ProjectReference with ReferenceOutputAssembly="false" so it is built first. -->
  <Target Name="SkyWrightHousecarlLibrary" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SkyWrightHousecarlLibrary)' == 'true'">
    <MSBuild Projects="$(HousecarlSrc)housecarl-mcp\housecarl-mcp.csproj" Targets="GetTargetPath" Properties="Configuration=$(SkyWrightConfiguration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_SwHousecarlLibrary" />
    </MSBuild>
    <ItemGroup>
      <Reference Include="housecarl-mcp" HintPath="$(_SwHousecarlLibrary)" />
    </ItemGroup>
  </Target>

  <!-- For workbench.tests ONLY: houseCARL's server program where the pin's own project builds it, as the assembly
       metadata HousecarlServerProgram, for the tests that start houseCARL's server the way an AI client does (H5a,
       H5b). Nothing else in the build learns this path, and no build folder holds the program (BuildLayoutTests). -->
  <Target Name="SkyWrightTestServerProgram" BeforeTargets="GetAssemblyAttributes" Condition="'$(MSBuildProjectName)' == 'workbench.tests'">
    <MSBuild Projects="$(HousecarlSrc)housecarl-mcp\housecarl-mcp.csproj" Targets="GetTargetPath" Properties="Configuration=$(SkyWrightConfiguration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_SwTestServerDll" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>HousecarlServerProgram</_Parameter1>
        <_Parameter2>$([System.IO.Path]::ChangeExtension('$(_SwTestServerDll)', '.exe'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <!-- ...and the tests' folder holds no copy of that program: the rulebook generator the tests reference references the
       server project, which would bring its exe, runtimeconfig and deps along as copy items. Its assembly stays (the
       app's in-process houseCARL needs it); an older build's copy is cleaned away as an output no longer written. -->
  <Target Name="SkyWrightTestsHoldNoServerProgram" AfterTargets="GetCopyToOutputDirectoryItems" Condition="'$(MSBuildProjectName)' == 'workbench.tests'">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(TargetPath)' == 'housecarl-mcp.exe' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.json' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.dev.json' or '%(TargetPath)' == 'housecarl-mcp.deps.json' or '%(TargetPath)' == 'housecarl-mcp.staticwebassets.endpoints.json'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(TargetPath)' == 'housecarl-mcp.exe' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.json' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.dev.json' or '%(TargetPath)' == 'housecarl-mcp.deps.json' or '%(TargetPath)' == 'housecarl-mcp.staticwebassets.endpoints.json'" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_SourceItemsToCopyToOutputDirectoryIfDifferent)" Condition="'%(TargetPath)' == 'housecarl-mcp.exe' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.json' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.dev.json' or '%(TargetPath)' == 'housecarl-mcp.deps.json' or '%(TargetPath)' == 'housecarl-mcp.staticwebassets.endpoints.json'" />
      <AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)" Condition="'%(TargetPath)' == 'housecarl-mcp.exe' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.json' or '%(TargetPath)' == 'housecarl-mcp.runtimeconfig.dev.json' or '%(TargetPath)' == 'housecarl-mcp.deps.json' or '%(TargetPath)' == 'housecarl-mcp.staticwebassets.endpoints.json'" />
    </ItemGroup>
  </Target>

  <!-- After the app builds: the app data and the rulebook the app's in-process houseCARL reads (corpus.json) into Data\,
       and the marker that names the layout. The build holds no houseCARL program: the app and runcontrol run
       houseCARL's code in process (SkyWrightHousecarlLibrary above), and the server program is the integration module's
       (SkyWrightIntegrationServer below). A Tools\housecarl-mcp\ left by an older build is removed. -->
  <Target Name="SkyWrightLayout" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'workbench'">
    <PropertyGroup>
      <_SwCorpus>$(HousecarlRoot)generated\corpus.json</_SwCorpus>
      <_SwJson>{ "kind": "skywright-build", "configuration": "$(SkyWrightConfiguration)", "framework": "$(SkyWrightFramework)", "app": "SkyWright.exe", "program": "$(SkyWrightProbes)/{name}/{name}.exe", "tool": "$(SkyWrightTools)/{name}/{name}.exe", "tools": ["runcontrol"], "corpus": "$(SkyWrightData)/corpus.json", "registry": "$(SkyWrightData)/check-registry.json", "severity": "$(SkyWrightData)/workbench-severity.json", "scenePolicy": "$(SkyWrightData)/scene-policy.json" }</_SwJson>
    </PropertyGroup>
    <ItemGroup>
      <_SwDataFiles Include="$(MSBuildThisFileDirectory)data\*" />
    </ItemGroup>
    <Error Condition="'$([System.IO.Path]::GetFullPath($(OutDir)))' != '$([System.IO.Path]::GetFullPath($(SkyWrightLayoutRoot)))'" Text="the app was built to $(OutDir), but SkyWright's layout is $(SkyWrightLayoutRoot); build without -o or OutputPath (scripts\build.ps1), so the app, its programs and its marker stay together." />
    <RemoveDir Condition="Exists('$(SkyWrightLayoutRoot)$(SkyWrightTools)\housecarl-mcp')" Directories="$(SkyWrightLayoutRoot)$(SkyWrightTools)\housecarl-mcp" />
    <Warning Condition="!Exists('$(_SwCorpus)')" Text="the rulebook $(_SwCorpus) is missing, so SkyWright cannot write patches; run scripts\build.ps1, which makes it." />
    <Copy SourceFiles="@(_SwDataFiles)" DestinationFolder="$(SkyWrightLayoutRoot)$(SkyWrightData)\" SkipUnchangedFiles="true" />
    <Delete Condition="!Exists('$(_SwCorpus)')" Files="$(SkyWrightLayoutRoot)$(SkyWrightData)\corpus.json" />
    <Copy Condition="Exists('$(_SwCorpus)')" SourceFiles="$(_SwCorpus)" DestinationFolder="$(SkyWrightLayoutRoot)$(SkyWrightData)\" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(SkyWrightLayoutRoot)$(SkyWrightLayoutMarker)" Lines="$(_SwJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The houseCARL integration module, integration\housecarl\ (its own solution, housecarl-integration.sln, which
       scripts\build.ps1 builds after the app's): AI-facing tools that use SkyWright and that nothing in the app, the
       probes or the scan reads. Its programs build outside the app's build folder, one folder per configuration,
       integration\housecarl\bin\<Configuration>\: Probes\<name>\ (lookprobe), Tools\winrt-tts\, Tools\evalcontrol\, Tools\housecarl-mcp\
       (houseCARL's server, built from the pin, with its rulebook), Tests\<name>\, and the
       marker housecarl-integration-layout.json. The guards learn that folder from here (assembly metadata), so no one
       else spells it. -->
  <PropertyGroup>
    <SkyWrightHarness>$(MSBuildThisFileDirectory)_geometry-harness\</SkyWrightHarness>
    <SkyWrightIntegration>$(MSBuildThisFileDirectory)integration\housecarl\</SkyWrightIntegration>
    <SkyWrightIntegrationLayoutRoot>$(SkyWrightIntegration)bin\$(SkyWrightConfiguration)\</SkyWrightIntegrationLayoutRoot>
    <SkyWrightIntegrationMarker>housecarl-integration-layout.json</SkyWrightIntegrationMarker>
    <_SwInIntegration>$([System.String]::Copy('$(MSBuildProjectDirectory)\').ToUpperInvariant().StartsWith($(SkyWrightIntegration.ToUpperInvariant())))</_SwInIntegration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SwInIntegration)' == 'True'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <_SwIntFolder>$(SkyWrightProbes)\$(MSBuildProjectName)\</_SwIntFolder>
    <_SwIntFolder Condition="'$(MSBuildProjectName)' == 'winrt-tts'">$(SkyWrightTools)\winrt-tts\</_SwIntFolder>
    <_SwIntFolder Condition="'$(MSBuildProjectName)' == 'evalcontrol'">$(SkyWrightTools)\evalcontrol\</_SwIntFolder>
    <_SwIntFolder Condition="$(MSBuildProjectName.EndsWith('.Tests'))">Tests\$(MSBuildProjectName)\</_SwIntFolder>
    <OutputPath>$(SkyWrightIntegrationLayoutRoot)$(_SwIntFolder)</OutputPath>
  </PropertyGroup>
  <Target Name="SkyWrightIntegrationLayout" AfterTargets="Build" Condition="'$(_SwInIntegration)' == 'True'">
    <PropertyGroup>
      <_SwIntJson>{ "kind": "housecarl-integration-build", "configuration": "$(SkyWrightConfiguration)", "program": "$(SkyWrightProbes)/{name}/{name}.exe", "tool": "$(SkyWrightTools)/{name}/{name}.exe", "tools": ["winrt-tts", "housecarl-mcp", "evalcontrol"] }</_SwIntJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(SkyWrightIntegrationLayoutRoot)$(SkyWrightIntegrationMarker)" Lines="$(_SwIntJson)" Overwrite="true" WriteOnlyWhenDifferent="true" ContinueOnError="WarnAndContinue" />
  </Target>
  <!-- houseCARL's server program belongs to the module (its AI-facing tools start it; the app runs houseCARL's code in
       process and holds no server): when the module's solution builds the pin's server project, its output and the
       rulebook it reads (corpus.json, beside it) go into the module's Tools\housecarl-mcp\. -->
  <Target Name="SkyWrightIntegrationServer" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'housecarl-mcp' and '$(SolutionName)' == 'housecarl-integration'">
    <PropertyGroup>
      <_SwIntCorpus>$(HousecarlRoot)generated\corpus.json</_SwIntCorpus>
      <_SwIntServer>$(SkyWrightIntegrationLayoutRoot)$(SkyWrightTools)\housecarl-mcp\</_SwIntServer>
    </PropertyGroup>
    <ItemGroup>
      <_SwIntServerFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SwIntServerFiles)" DestinationFiles="@(_SwIntServerFiles->'$(_SwIntServer)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Warning Condition="!Exists('$(_SwIntCorpus)')" Text="the rulebook $(_SwIntCorpus) is missing, so the module's houseCARL server cannot write patches; run scripts\build.ps1, which makes it." />
    <Delete Condition="!Exists('$(_SwIntCorpus)')" Files="$(_SwIntServer)corpus.json" />
    <Copy Condition="Exists('$(_SwIntCorpus)')" SourceFiles="$(_SwIntCorpus)" DestinationFolder="$(_SwIntServer)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SkyWright.Guards'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HousecarlIntegrationBuild</_Parameter1>
      <_Parameter2>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(SkyWrightIntegrationLayoutRoot)').Replace('\', '/'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HousecarlIntegrationMarker</_Parameter1>
      <_Parameter2>$(SkyWrightIntegrationMarker)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
