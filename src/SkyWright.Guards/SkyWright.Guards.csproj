<Project Sdk="Microsoft.NET.Sdk">

  <!-- SkyWright's guards: checks over its own tree that a build and the unit tests do not reach. The harness-suites
       guard came from houseCARL's generator in the split's M2 (houseCARL's copy leaves in M3). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkyWright.Guards</RootNamespace>
    <AssemblyName>SkyWright.Guards</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\_geometry-harness\_shared\CheckoutLayout.cs" Link="CheckoutLayout.cs" />
  </ItemGroup>

</Project>
