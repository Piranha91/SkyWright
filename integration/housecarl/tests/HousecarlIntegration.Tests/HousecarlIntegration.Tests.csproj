<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the houseCARL integration module's C#: lookprobe's whole-order looks (OrderLooksTests, moved from
       SkyWright.Engine.Tests with the three look files in step 1 of the boundary), and the stage ledger runcontrol and the
       module's pipeline share (StageLedgerSeamTests, step 2). The looks compile here from
       lookprobe's folder; the engine types they build on (OrderLooks, SwapLooks, BaseObjectSwaps) come from
       SkyWright.Engine. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkyWright.Engine.Tests</RootNamespace>
    <AssemblyName>HousecarlIntegration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- SkillCommandLinesTests read houseCARL's MCP tool methods out of the built housecarl-mcp.dll without loading it
         (it is built against other versions of the framework's libraries than this test runs on) -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
    <!-- built first, not referenced: EvalcontrolTests start the program from the module's layout -->
    <ProjectReference Include="..\..\evalcontrol\evalcontrol.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- nearprobe: NearprobeTests start the program from the module's layout, and call its question in process for the
         two answers a separate process cannot reach (a plugin that becomes unreadable after the index is built) -->
    <!-- under an alias: the _shared files it links (HarnessOrderCli and its kin) are also in runcontrol.dll -->
    <ProjectReference Include="..\..\nearprobe\nearprobe.csproj" Aliases="nearprobe" />
  </ItemGroup>

  <!-- the engine's own test worlds (NearSelectionTests.World, DoorsNearTests.World, DoorsNearUnreadTests.World), from the
       app's build (scripts\build.ps1 builds the app before this module): NearprobeTests ask nearprobe on the very fixtures
       the engine's known answers are about, so no fixture is copied here. -->
  <ItemGroup>
    <Reference Include="SkyWright.Engine.Tests">
      <HintPath>$(SkyWrightLayoutRoot)Tests\SkyWright.Engine.Tests\SkyWright.Engine.Tests.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- runcontrol's stage ledger, from the app's build (scripts\build.ps1 builds the app before this module), for the
       seam tests that compare it with the module's Python pipeline (StageLedgerSeamTests). -->
  <ItemGroup>
    <Reference Include="runcontrol">
      <HintPath>$(SkyWrightLayoutRoot)$(SkyWrightTools)\runcontrol\runcontrol.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\lookprobe\InactivePatchLook.cs" Link="InactivePatchLook.cs" />
    <Compile Include="..\..\lookprobe\DummyTargetLook.cs" Link="DummyTargetLook.cs" />
    <Compile Include="..\..\lookprobe\ScriptDependencyLook.cs" Link="ScriptDependencyLook.cs" />
    <!-- adviceprobe's author-stated-order extractor and the shared rules file reader it writes for (AdviceProofTests) -->
    <Compile Include="..\..\adviceprobe\OrderAdvice.cs" Link="OrderAdvice.cs" />
    <Compile Include="$(SkyWrightHarness)_shared\OrderRules.cs" Link="OrderRules.cs" />
    <!-- fomodprobe's FOMOD decision model, for proofprobe's moved FOMOD section (FomodProofTests) -->
    <Compile Include="..\..\fomodprobe\FomodModel.cs" Link="FomodModel.cs" />
    <!-- houseCARL's .pex fixture writer, compiled from the pin (OrderLooksTests writes scripts with it). -->
    <Compile Include="$(HousecarlSrc)housecarl-mcp-tests\PexWriter.cs" Link="PexWriter.cs" />
  </ItemGroup>

</Project>
