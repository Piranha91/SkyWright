<Project Sdk="Microsoft.NET.Sdk">
  <!-- patchfind: the houseCARL integration module's patch finder (patchprobe's discovery modes, moved in step 3 of the
       SkyWright / houseCARL boundary). It reads SkyWright's sweep of the machine (_shared/PatchIndex.cs, which
       SkyWright's patchprobe reads too, for its verify mode) and writes the hit list (DiscoveryHits.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>patchfind</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(SkyWrightHarness)_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="$(SkyWrightHarness)_shared\PatchIndex.cs" Link="PatchIndex.cs" />
  </ItemGroup>
</Project>
