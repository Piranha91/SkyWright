<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org serves every package but Nifly, the NiflySharp fork houseCARL builds itself; the pinned houseCARL vendors it. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="housecarl-local" value="external/houseCARL/packages/local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="housecarl-local">
      <package pattern="Nifly" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
