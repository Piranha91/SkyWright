<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>runcontrol</AssemblyName>
    <RootNamespace>RunControl</RootNamespace>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\housecarl-core\housecarl-core.csproj" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <EmbeddedResource Include="known-answers\foundations.json" LogicalName="foundations.json" />
  </ItemGroup>
</Project>
