<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>runcontrol</AssemblyName>
    <RootNamespace>RunControl</RootNamespace>
    <NoWarn>CA1416</NoWarn>
    <!-- houseCARL's server code compiled in as a library (Directory.Build.props), never its program: the names read -->
    <SkyWrightHousecarlLibrary>true</SkyWrightHousecarlLibrary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
    <!-- built first, its program not referenced: SkyWrightHousecarlLibrary references its assembly alone -->
    <ProjectReference Include="$(HousecarlSrc)housecarl-mcp\housecarl-mcp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <Compile Include="..\_shared\HousecarlCalls.cs" Link="HousecarlCalls.cs" />
    <Compile Include="..\_shared\HousecarlRulebook.cs" Link="HousecarlRulebook.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\CheckoutLayout.cs" Link="CheckoutLayout.cs" />
    <Compile Include="..\_shared\HarnessOrderCli.cs" Link="HarnessOrderCli.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\OrderMasters.cs" Link="OrderMasters.cs" />
    <Compile Include="..\_shared\BaseGamePlugins.cs" Link="BaseGamePlugins.cs" />
    <Compile Include="..\_shared\PopulationRules.cs" Link="PopulationRules.cs" />
    <EmbeddedResource Include="known-answers\foundations.json" LogicalName="foundations.json" />
    <EmbeddedResource Include="known-answers\pipeline.json" LogicalName="pipeline.json" />
    <EmbeddedResource Include="known-answers\plan-modules.json" LogicalName="plan-modules.json" />
    <EmbeddedResource Include="known-answers\plan-command.json" LogicalName="plan-command.json" />
    <EmbeddedResource Include="known-answers\sweep.json" LogicalName="sweep.json" />
    <EmbeddedResource Include="known-answers\finalize.json" LogicalName="finalize.json" />
    <EmbeddedResource Include="known-answers\evaluate.json" LogicalName="evaluate.json" />
    <EmbeddedResource Include="known-answers\bundle.json" LogicalName="bundle.json" />
    <EmbeddedResource Include="known-answers\rows.json" LogicalName="rows.json" />
    <EmbeddedResource Include="known-answers\records-stage.json" LogicalName="records-stage.json" />
  </ItemGroup>
</Project>
