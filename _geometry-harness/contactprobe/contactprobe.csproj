<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>contactprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\housecarl-core\housecarl-core.csproj" />
    <Compile Include="..\_shared\EnablePopulation.cs" Link="EnablePopulation.cs" />
    <Compile Include="..\_shared\EnableArms.cs" Link="EnableArms.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\ConflictReport.cs" Link="ConflictReport.cs" />
    <Compile Include="..\_shared\DetectorModel.cs" Link="DetectorModel.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\HarnessOrderCli.cs" Link="HarnessOrderCli.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\PlacementHistory.cs" Link="PlacementHistory.cs" />
    <Compile Include="..\_shared\DeletionHistory.cs" Link="DeletionHistory.cs" />
    <Compile Include="..\_shared\DependencyIndex.cs" Link="DependencyIndex.cs" />
    <Compile Include="..\_shared\BosHook.cs" Link="BosHook.cs" />
    <Compile Include="..\_shared\OverlapIndex.cs" Link="OverlapIndex.cs" />
    <Compile Include="..\_shared\MotionPlacements.cs" Link="MotionPlacements.cs" />
    <Compile Include="..\_shared\ContactIndex.cs" Link="ContactIndex.cs" />
    <Compile Include="..\_shared\ContactAssembly.cs" Link="ContactAssembly.cs" />
    <Compile Include="..\_shared\PlacementCache.cs" Link="PlacementCache.cs" />
    <Compile Include="..\_shared\CollisionLayers.cs" Link="CollisionLayers.cs" />
    <Compile Include="..\_shared\ActorBand.cs" Link="ActorBand.cs" />
    <Compile Include="..\_shared\WorldState.cs" Link="WorldState.cs" />
    <Compile Include="..\_shared\StateArm.cs" Link="StateArm.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The alpha-visibility option (Stage D alpha sampling): the texture reader and its DDS decoder. Pfim 0.11.4, MIT (https://github.com/nickbabcock/Pfim). -->
    <Compile Include="..\_shared\TextureAlpha.cs" Link="TextureAlpha.cs" />
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>
</Project>
