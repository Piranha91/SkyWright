<Project Sdk="Microsoft.NET.Sdk">
  <!-- The conflict review workbench: viewprobe's built scene in a WPF window (GLWpfControl on viewprobe's own GL
       context), select / move / rotate a placed reference, and the edit written as a placement override by the
       houseCARL server this checkout builds. -->
  <PropertyGroup>
    <!-- a windowed program: no console window beside it; standard output still reaches a parent that captures it, and SessionLog writes it to a file -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkyWright</AssemblyName>
    <RootNamespace>Workbench</RootNamespace>
    <UseWPF>true</UseWPF>
    <NoWarn>CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- houseCARL's server code compiled in as a library (Directory.Build.props), never its program -->
    <SkyWrightHousecarlLibrary>true</SkyWrightHousecarlLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="workbench.tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\DifferentialRows.cs" Link="DifferentialRows.cs" />
    <Compile Include="..\_shared\CheckoutLayout.cs" Link="CheckoutLayout.cs" />
    <Compile Include="..\_shared\HousecarlCalls.cs" Link="HousecarlCalls.cs" />
    <ProjectReference Include="..\viewprobe\viewprobe.csproj" />
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
    <!-- built first, its program not referenced: the SkyWrightLayout target (Directory.Build.props) copies it into
         Tools\housecarl-mcp, and SkyWrightHousecarlLibrary references its assembly alone -->
    <ProjectReference Include="$(HousecarlSrc)housecarl-mcp\housecarl-mcp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The MCP state tools: a localhost Streamable HTTP server inside the app (DESIGN.md section 7). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
