<!doctype html><html><head><meta charset="utf-8"><title>{{ p.reader.title }}</title><style>{{ css }}</style></head><body class="{{ p.layout }}"><main>
<h1>{{ p.reader.title }}</h1><p>{{ p.reader.scopeLine }}</p><section class="claim"><h2>Result</h2><p><strong>{{ p.reader.verdict }}</strong></p><ul>{% for x in p.reader.limitations %}<li>{{ x }}</li>{% endfor %}</ul></section>
<p>Evaluation record: {{ p.reader.context.evaluatedAt or "date not supplied" }}. States examined: {{ p.reader.context.statesExamined|join(", ") or "none named" }}. Additional states not examined: {{ p.reader.context.statesNotExamined|join(", ") or "none named" }}.</p>
<h2>Setups compared</h2><ul>{% for a in p.scope.arms %}<li><strong>{{ a.displayLabel }}</strong>{% if a.pluginsAdded %}: adds {{ a.pluginsAdded|join(", ") }}{% endif %}{% if a.pluginsRemoved %}; removes {{ a.pluginsRemoved|join(", ") }}{% endif %}. {{ a.readerLimits|join(" ") }}</li>{% endfor %}</ul>
{% set regs=p.findings|selectattr("kind","equalto","regression")|list %}<h2>Problems introduced by the supplied setup</h2>{% for f in regs %}<h3>{{ (p.reader.checkTitles or {}).get(f.checkId,f.title) }}</h3><p><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }} <a href="evidence-index.md#{{ f.id }}">Full evidence</a>.</p>{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.md#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% else %}<p>No new physical defect was reported by the completed comparisons.</p>{% endfor %}
<h2>What the checks found</h2>{% for cb in p.findingBlocks %}<h3>{{ (p.reader.checkTitles or {}).get(cb.checkId,cb.title) }}</h3>{% if (p.reader.checkExplanations or {}).get(cb.checkId) %}<p>{{ p.reader.checkExplanations.get(cb.checkId) }}</p>{% endif %}<ul>{% for part in cb.parts if not part.indexOnly %}{% for f in part.groups if f.readerRelevant %}<li><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }} <a href="evidence-index.md#{{ f.id }}">Full evidence</a>.</li>{% endfor %}{% for f in part.groups if f.readerRelevant %}{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.md#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% endfor %}{% endfor %}</ul>{% endfor %}
<h2>Changes made by the supplied setup</h2><ul>{% for f in p.findings if f.kind in ["repaired","reclassified"] %}<li><strong>{{ f.readerArmLabel }} — {{ (p.reader.checkTitles or {}).get(f.checkId, "Additional check") }}:</strong> {{ f.readerPlain }} <a href="evidence-index.md#{{ f.id }}">Full evidence</a>.</li>{% else %}<li>No measured repair or ownership change was recorded.</li>{% endfor %}</ul>
<h2>What still needs checking</h2><ul>{% for row in p.reader.missingSummary %}<li><strong>{{ row.reason|capitalize }}:</strong> {{ row.subjects|join("; ") }}.</li>{% else %}<li>Every required comparison has an accepted result.</li>{% endfor %}</ul>
<h2>Checks that found no problem</h2><ul>{% for item in p.reader.nullSummary %}<li>{{ item }}.</li>{% else %}<li>No completed no-finding check is recorded.</li>{% endfor %}</ul>
<h2>Reference information collected</h2><p>{% if p.reader.catalogueSummary %}{{ p.reader.catalogueSummary|join("; ") }}.{% else %}No catalogue-only result is recorded.{% endif %}</p>
<h2>Evidence and limits</h2><ul>{% for item in p.reader.get("otherLimits", []) %}<li>{{ item }}</li>{% endfor %}</ul><p>The <a href="evidence-index.md">evidence index</a> contains exact check names, setup identifiers, result codes, record keys, hashes, omitted rows, and provenance.</p></main></body></html>
