{# report.css is inlined UNESCAPED, as in evidence-index.html.j2: this environment autoescapes, and escaping
   the stylesheet turns `font-family: "Segoe UI", Arial, ...` into `font-family: &#34;Segoe UI&#34;, ...`. A
   character reference is HTML text, not CSS - the browser drops the declaration and prints the report in its
   default font at other metrics. `css` is this repo's own report.css, read from the templates folder beside
   this template; it is never bundle data. Every value below comes from the bundle and stays escaped. #}
<!doctype html><html><head><meta charset="utf-8"><title>{{ p.reader.title }}</title><style>{{ css|safe }}</style></head><body class="{{ p.layout }}"><main>
<h1>{{ p.reader.title }}</h1><p>{{ p.reader.scopeLine }}</p>
{% set pred = p.reader.prediction %}{% set cov = p.reader.coverage %}{% set val = p.reader.validation %}
<section class="claim"><h2>{{ p.reader.sectionHeadings.prediction }}</h2><p><strong>{{ pred.verdict }}</strong></p>{% if pred.get("withPatchLine") %}{% if pred.get("withPatchLines") %}<p>{{ pred.withPatchHead }}</p><ul>{% for ln in pred.withPatchLines %}<li>{{ ln }}</li>{% endfor %}</ul>{% if pred.get("withPatchStays") %}<p>{{ pred.withPatchStays }}</p>{% endif %}{% else %}<p>{{ pred.withPatchLine }}</p>{% endif %}{% endif %}
{% set lead_items = pred["items"]|rejectattr("shownAs", "equalto", "alone")|list %}{% set alone = pred["items"]|selectattr("shownAs", "equalto", "alone")|list %}{% if lead_items %}<ul>{% for g in lead_items %}<li><strong>{{ g.title }}:</strong> {{ g.plain }}{% if g.inGameText %} {{ g.inGameText }}{% endif %}{% for fid in g.findingIds[:4] %} <a href="evidence-index.html#{{ fid }}">{{ "Full evidence" if loop.first else "and " ~ fid }}</a>{% if loop.last %}.{% endif %}{% endfor %}</li>{% endfor %}</ul>{% endif %}{% if pred.get("onceLines") %}<p>{{ pred.onceLines|join(" ") }}</p>{% endif %}{% if pred.get("historyLossLines") %}<ul>{% for h in pred.historyLossLines %}<li>{{ h.text }}{% for fid in (h.findingIds[:4] if h.get("linkAll") else h.findingIds[:1]) %}{% if loop.first %} <a href="evidence-index.html#{{ fid }}">Evidence</a>{% else %} <a href="evidence-index.html#{{ fid }}">{{ fid }}</a>{% endif %}{% if loop.last %}.{% endif %}{% endfor %}</li>{% endfor %}</ul>{% endif %}{% if pred.get("orderRiskLines") %}<ul>{% for o in pred.orderRiskLines %}<li>{{ o.text }} <a href="{{ o.path }}">Evidence</a>.</li>{% endfor %}</ul>{% endif %}{% if alone %}<p><strong>{{ pred.singleModHeading }}</strong></p><ul>{% for a in pred.get("aloneLines") or [] %}<li><strong>{{ a.title }}</strong> ({{ a.unit }}): {% for g in a.groups %}{{ g.from }} {% for e in g.entries %}{{ e.text }}{% for fid in e.findingIds[:1] %} (<a href="evidence-index.html#{{ fid }}">evidence</a>){% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}{% if not loop.last %}; {% endif %}{% endfor %}. {{ a.inGameText }}</li>{% endfor %}</ul>{% endif %}
{% if pred.get("siblingSource") %}<p>{{ pred.siblingSource }}</p>{% endif %}{% for x in pred.get("alsoEvaluations") or [] %}<p>{{ x }}</p>{% endfor %}{% if pred.noneFoundBasis %}<p>{{ pred.noneFoundBasis }}</p>{% endif %}{% for item in pred.missingFacts %}<p>{{ item }}</p>{% endfor %}</section>
<section><h2>{{ p.reader.sectionHeadings.coverage }}</h2><ul>{% for line in cov.lines %}<li><strong>{{ line.reason }}:</strong>{% if line.count is not none %} {{ line.count|n }}{% if line.get("unit") %} {{ line.unit }}{% endif %}{% if line.subject %} —{% endif %}{% endif %}{% if line.subject %} {{ line.subject }}{% endif %}.</li>{% else %}<li>No check on the setup with the evaluated mods reported anything it could not judge.</li>{% endfor %}{% for item in cov.notes %}<li>{{ item }}</li>{% endfor %}</ul>
{% if cov.setAsideLine and "aside" not in (p.layout or "").split() %}<p>{{ cov.setAsideLine }} <a href="evidence-index.html#prediction-record">Prediction record</a>.</p>{% elif cov.setAsideLine %}<p>{{ p.reader.get("asideMovedLine") or "What the counts above leave out, and why, is in the evidence index." }} <a href="evidence-index.html#further-notes">Further notes</a>.</p>{% endif %}</section>
<section><h2>{{ p.reader.sectionHeadings.validation }}</h2>{% if val.status == "no-patch" %}<p>{{ val.sentence }}</p><p>{{ val.other }}</p>{% else %}<p>{% if val.get("summary") %}{{ val.summary }}{% if val.headlineShown %} {{ val.headlineShown }}{% endif %}{% else %}{{ val.headline }}{% endif %}</p><ul>{% for s in val.sentences %}<li>{{ s }}{% if s == val.get("undoneSentence") %}{% for fid in val.undoneFindingIds[:1] %} <a href="evidence-index.html#{{ fid }}">{{ fid }}</a>{% endfor %}{% endif %}{% if s == val.get("replacedSentence") %}{% for fid in val.replacedFindingIds[:1] %} <a href="evidence-index.html#{{ fid }}">{{ fid }}</a>{% endfor %}{% endif %}</li>{% endfor %}{% if val.get("newByCheck") %}<li>{{ val.newByCheckHeading }}: {% for n in val.newByCheck %}{{ n.title }} {{ n.count|n }}{% if n.get("masterNote") %} ({{ n.masterNote }}){% endif %}{% if n.get("objectsNote") %}: {{ n.objectsNote }}{% endif %}{% for fid in n.findingIds %} <a href="evidence-index.html#{{ fid }}">{{ fid }}</a>{% endfor %}{% if not loop.last %}; {% endif %}{% endfor %}.</li>{% endif %}</ul>{% if val.get("itemLines") %}<ul>{% for s in val.itemLines %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}{% for s in val.missingFacts %}<p>{{ s }}</p>{% endfor %}{% endif %}</section>
<p>Evaluation record: {{ p.reader.context.evaluatedAt or "date not supplied" }}. States examined: {{ p.reader.context.statesExamined|join(", ") or "none named" }}. Additional states not examined: {{ p.reader.context.statesNotExamined|join(", ") or "none named" }}.</p>
<h2>Setups compared</h2><ul>{% for a in p.scope.arms %}<li><strong>{{ a.displayLabel }}</strong>{% if a.pluginsAdded %}: adds {{ a.pluginsAdded|join(", ") }}{% endif %}{% if a.pluginsRemoved %}{{ "; " if a.pluginsAdded else ": " }}removes {{ a.pluginsRemoved|join(", ") }}{% endif %}{% if a.get("setupOrdinal") %} ({{ a.get("setupOrdinal") }}){% endif %}. {{ a.readerLimits|join(" ") }}</li>{% endfor %}</ul>
{% if "order" not in (p.layout or "").split() %}<h2>{{ p.reader.locationOrder.heading or "Load order for these locations" }}</h2><p>{{ p.reader.locationOrder.intro or "Plugins tied to the places discussed below, in measured order." }}</p>
{% for a in p.scope.arms %}
<h3>{{ a.readerLabel }}</h3>
{% if a.get("sameListAs") %}<p>{{ a.locationPluginScope.missingInput }}</p>{% else %}{% if a.locationPluginOrder %}<p>{{ a.locationPluginOrder|join(", ") }}.</p>
{% else %}<p>{{ p.reader.locationOrder.empty or "No evidenced plugin was identified." }}</p>{% endif %}
{% if a.locationPluginScope.get("sameAs") %}<p>{{ p.reader.locationOrder.sameScope or "Scope: the same locations as listed for" }} <strong>{{ a.locationPluginScope.sameAs }}</strong>.</p>{% else %}<p>Scope:</p><pre><code>{{ (a.locationPluginScope.get("shown", a.locationPluginScope.locations))|join("; ") or "no CELL or worldspace location was supplied" }}</code></pre>{% if a.locationPluginScope.get("moreLine") %}<p>{{ a.locationPluginScope.moreLine }} <a href="evidence-index.html#scope">Evidence index</a>.</p>{% endif %}{% endif %}
<p>Coverage: {% if a.locationPluginScope.complete %}all contributors to the listed locations identified.{% else %}incomplete — {{ a.locationPluginScope.missingInput }}{% endif %}{% if a.locationPluginScope.get("note") %} {{ a.locationPluginScope.note }}{% endif %}</p>{% endif %}
{% endfor %}{% endif %}
{% set regs=p.findings|selectattr("kind","equalto","regression")|selectattr("readerRelevant")|list %}<h2>{{ p.reader.sectionHeadings.regressions }}</h2>{% for f in regs %}<h3>{{ (p.reader.checkTitles or {}).get(f.checkId,f.title) }}</h3><p><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</p>{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.html#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% else %}<p>{{ val.get("noRegressionLine") or "No new physical defect was reported by the completed comparisons." }}{% for x in p.reader.get('refusedSummary') or [] %} {{ x }}{% endfor %}</p>{% endfor %}
<h2>What the checks found</h2>{% for cb in p.findingBlocks %}<h3>{{ (p.reader.checkTitles or {}).get(cb.checkId,cb.title) }}</h3>{% if (p.reader.checkExplanations or {}).get(cb.checkId) %}<p>{{ p.reader.checkExplanations.get(cb.checkId) }}</p>{% endif %}<ul>{% for part in cb.parts if not part.indexOnly %}{% for c in part.get("compact") or [] %}{% if c.get("entries") %}<li><strong>{{ c.readerArmLabel }}:</strong> {% for e in c.entries %}{{ e.text }} (<a href="evidence-index.html#{{ e.id }}">evidence</a>{% for m in e.get("more") or [] %} <a href="evidence-index.html#{{ m }}">{{ m }}</a>{% endfor %}){% if not loop.last %}; {% endif %}{% endfor %}.{% if c.note %} {{ c.note }}{% endif %}</li>{% else %}<li><strong>{{ c.readerArmLabel }}:</strong> {{ c.text }}.{% for i in c.ids[:1] %} <a href="evidence-index.html#{{ i }}">Full evidence</a>{% endfor %}{% for m in c.ids[1:] %} <a href="evidence-index.html#{{ m }}">{{ m }}</a>{% endfor %}.</li>{% endif %}{% endfor %}{% for f in part.groups if f.readerRelevant %}<li><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }}{% if f.get("readerProvenance") %} {{ f.readerProvenance }}{% endif %} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</li>{% endfor %}{% for f in part.groups if f.readerRelevant %}{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.html#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% endfor %}{% endfor %}</ul>{% endfor %}
{% if p.reader.get("detailAsideLine") %}<p>{{ p.reader.detailAsideLine }} <a href="evidence-index.html#detail-set-aside">Set aside from this list</a>.</p>{% endif %}{% if p.reader.get("detailSingleModLine") %}<p>{{ p.reader.detailSingleModLine }} <a href="evidence-index.html#detail-set-aside">Set aside from this list</a>.</p>{% endif %}
<h2>{{ p.reader.sectionHeadings.changes }}</h2><ul>{% for f in p.findings if f.kind in ["repaired","reclassified"] and f.readerRelevant %}<li><strong>{{ f.readerArmLabel }} — {{ (p.reader.checkTitles or {}).get(f.checkId, "Additional check") }}:</strong> {{ f.readerPlain }} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</li>{% else %}<li>{{ val.get("noChangeLine") or "No measured repair or ownership change was recorded." }}</li>{% endfor %}{% if "tail" not in (p.layout or "").split() %}{% for item in p.reader.comparisonSummary %}<li>{{ item }}</li>{% endfor %}{% endif %}</ul>
{% if "tail" in (p.layout or "").split() and "aside" in (p.layout or "").split() %}<p>{{ p.reader.get("tailMovedShort") or "Everything else is in the evidence index." }} <a href="evidence-index.html#further-notes">Further notes</a>.</p>{% elif "tail" in (p.layout or "").split() %}<h2>Further notes</h2><p>{{ p.reader.get("tailMovedLine") or "The comparisons' other results, what still needs checking, the clean checks, the reference information and the evidence notes are in the evidence index." }}{% if "order" in (p.layout or "").split() %} {{ p.reader.get("orderMovedLine") or "So is the load order for these locations." }}{% endif %} <a href="evidence-index.html#further-notes">Further notes</a>.</p>{% else %}<h2>What still needs checking</h2>{% if p.reader.get("missingCoveredLine") %}<p>{{ p.reader.missingCoveredLine }}</p>{% endif %}<ul>{% for row in (p.reader.missingShown if p.reader.get("missingShown") is not none else p.reader.missingSummary) %}<li><strong>{{ row.reason[:1]|upper }}{{ row.reason[1:] }}:</strong> {{ row.subjects|join("; ") }}.{% if row.explanation %} {{ row.explanation }}{% endif %}</li>{% else %}{% if not p.reader.get("missingCoveredLine") %}<li>Every required comparison has an accepted result.</li>{% endif %}{% endfor %}</ul>
<h2>Checks that found no problem</h2><ul>{% for item in p.reader.nullSummary %}<li>{{ item }}.</li>{% else %}<li>No completed no-finding check is recorded.</li>{% endfor %}</ul>
<h2>Reference information collected</h2><p>{% if p.reader.catalogueSummary %}{{ p.reader.catalogueSummary|join("; ") }}.{% else %}No catalogue-only result is recorded.{% endif %}</p>
<h2>Evidence and limits</h2><ul>{% for item in p.reader.get("otherLimits", []) %}<li>{{ item }}</li>{% endfor %}</ul><p>The <a href="evidence-index.html">evidence index</a> contains exact check names, setup identifiers, result codes, record keys, hashes, omitted rows, and provenance.</p>{% endif %}</main></body></html>
