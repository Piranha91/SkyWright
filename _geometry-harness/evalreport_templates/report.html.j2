{# report.css is inlined UNESCAPED, as in evidence-index.html.j2: this environment autoescapes, and escaping
   the stylesheet turns `font-family: "Segoe UI", Arial, ...` into `font-family: &#34;Segoe UI&#34;, ...`. A
   character reference is HTML text, not CSS - the browser drops the declaration and prints the report in its
   default font at other metrics. `css` is this repo's own report.css, read from the templates folder beside
   this template; it is never bundle data. Every value below comes from the bundle and stays escaped. #}
<!doctype html><html><head><meta charset="utf-8"><title>{{ p.reader.title }}</title><style>{{ css|safe }}</style></head><body class="{{ p.layout }}"><main>
<h1>{{ p.reader.title }}</h1><p>{{ p.reader.scopeLine }}</p>
{% set pred = p.reader.prediction %}{% set cov = p.reader.coverage %}{% set val = p.reader.validation %}
<section class="claim"><h2>{{ p.reader.sectionHeadings.prediction }}</h2><p><strong>{{ pred.verdict }}</strong></p>
{% set lead_items = pred["items"]|rejectattr("shownAs", "equalto", "alone")|list %}{% set alone = pred["items"]|selectattr("shownAs", "equalto", "alone")|list %}{% if lead_items %}<ul>{% for g in lead_items %}<li><strong>{{ g.title }}:</strong> {{ g.plain }} {{ g.inGameText }}{% for fid in g.findingIds[:1] %} <a href="evidence-index.html#{{ fid }}">Full evidence</a>.{% endfor %}</li>{% endfor %}</ul>{% endif %}{% if alone %}<p><strong>{{ pred.singleModHeading }}</strong></p><ul>{% for g in alone %}<li><strong>{{ g.title }}:</strong> {{ g.plain }} {{ g.inGameText }}{% for fid in g.findingIds[:1] %} <a href="evidence-index.html#{{ fid }}">Full evidence</a>.{% endfor %}</li>{% endfor %}</ul>{% endif %}
{% if pred.get("siblingSource") %}<p>{{ pred.siblingSource }}</p>{% endif %}{% if pred.noneFoundBasis %}<p>{{ pred.noneFoundBasis }}</p>{% endif %}{% for item in pred.missingFacts %}<p>{{ item }}</p>{% endfor %}</section>
<section><h2>{{ p.reader.sectionHeadings.coverage }}</h2><ul>{% for line in cov.lines %}<li><strong>{{ line.reason }}:</strong> {{ line.count|n }}{% if line.get("unit") %} {{ line.unit }}{% endif %}{% if line.subject %} — {{ line.subject }}{% endif %}.</li>{% else %}<li>No check on the setup with the evaluated mods reported anything it could not judge.</li>{% endfor %}{% for item in cov.notes %}<li>{{ item }}</li>{% endfor %}</ul>
{% if cov.setAsideLine %}<p>{{ cov.setAsideLine }} <a href="evidence-index.html#prediction-record">Prediction record</a>.</p>{% endif %}</section>
<section><h2>{{ p.reader.sectionHeadings.validation }}</h2>{% if val.status == "no-patch" %}<p>{{ val.sentence }}</p><p>{{ val.other }}</p>{% else %}<p>{{ val.headline }}</p><ul>{% for s in val.sentences %}<li>{{ s }}</li>{% endfor %}</ul>{% for s in val.missingFacts %}<p>{{ s }}</p>{% endfor %}{% endif %}</section>
<p>Evaluation record: {{ p.reader.context.evaluatedAt or "date not supplied" }}. States examined: {{ p.reader.context.statesExamined|join(", ") or "none named" }}. Additional states not examined: {{ p.reader.context.statesNotExamined|join(", ") or "none named" }}.</p>
<h2>Setups compared</h2><ul>{% for a in p.scope.arms %}<li><strong>{{ a.displayLabel }}</strong>{% if a.pluginsAdded %}: adds {{ a.pluginsAdded|join(", ") }}{% endif %}{% if a.pluginsRemoved %}{{ "; " if a.pluginsAdded else ": " }}removes {{ a.pluginsRemoved|join(", ") }}{% endif %}{% if a.get("setupOrdinal") %} ({{ a.get("setupOrdinal") }}){% endif %}. {{ a.readerLimits|join(" ") }}</li>{% endfor %}</ul>
<h2>{{ p.reader.locationOrder.heading or "Load order for these locations" }}</h2><p>{{ p.reader.locationOrder.intro or "Plugins tied to the places discussed below, in measured order." }}</p>
{% for a in p.scope.arms %}
<h3>{{ a.readerLabel }}</h3>
{% if a.locationPluginOrder %}<ul>{% for plugin in a.locationPluginOrder %}<li>{{ plugin }}</li>{% endfor %}</ul>
{% else %}<p>{{ p.reader.locationOrder.empty or "No evidenced plugin was identified." }}</p>{% endif %}
{% if a.locationPluginScope.get("sameAs") %}<p>{{ p.reader.locationOrder.sameScope or "Scope: the same locations as listed for" }} <strong>{{ a.locationPluginScope.sameAs }}</strong>.</p>{% else %}<p>Scope:</p><pre><code>{{ a.locationPluginScope.locations|join("; ") or "no CELL or worldspace location was supplied" }}</code></pre>{% endif %}
<p>Coverage: {% if a.locationPluginScope.complete %}all contributors to the listed locations identified{% else %}incomplete — {{ a.locationPluginScope.missingInput }}{% endif %}</p>
{% endfor %}
{% set regs=p.findings|selectattr("kind","equalto","regression")|selectattr("readerRelevant")|list %}<h2>{{ p.reader.sectionHeadings.regressions }}</h2>{% for f in regs %}<h3>{{ (p.reader.checkTitles or {}).get(f.checkId,f.title) }}</h3><p><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</p>{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.html#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% else %}<p>No new physical defect was reported by the completed comparisons.</p>{% endfor %}
<h2>What the checks found</h2>{% for cb in p.findingBlocks %}<h3>{{ (p.reader.checkTitles or {}).get(cb.checkId,cb.title) }}</h3>{% if (p.reader.checkExplanations or {}).get(cb.checkId) %}<p>{{ p.reader.checkExplanations.get(cb.checkId) }}</p>{% endif %}<ul>{% for part in cb.parts if not part.indexOnly %}{% for f in part.groups if f.readerRelevant %}<li><strong>{{ f.readerArmLabel }}:</strong> {{ f.readerPlain }}{% if f.get("readerProvenance") %} {{ f.readerProvenance }}{% endif %} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</li>{% endfor %}{% for f in part.groups if f.readerRelevant %}{% for m in f.figures %}{% if m.reportPath %}<figure><img src="{{ m.reportPath }}" alt="Evidence image"><figcaption>Evidence image. <a href="evidence-index.html#{{ m.id }}">Image provenance</a>.</figcaption></figure>{% endif %}{% endfor %}{% endfor %}{% endfor %}</ul>{% endfor %}
{% if p.reader.get("detailAsideLine") %}<p>{{ p.reader.detailAsideLine }} <a href="evidence-index.html#detail-set-aside">Set aside from this list</a>.</p>{% endif %}{% if p.reader.get("detailSingleModLine") %}<p>{{ p.reader.detailSingleModLine }} <a href="evidence-index.html#detail-set-aside">Set aside from this list</a>.</p>{% endif %}
<h2>{{ p.reader.sectionHeadings.changes }}</h2><ul>{% for f in p.findings if f.kind in ["repaired","reclassified"] and f.readerRelevant %}<li><strong>{{ f.readerArmLabel }} — {{ (p.reader.checkTitles or {}).get(f.checkId, "Additional check") }}:</strong> {{ f.readerPlain }} <a href="evidence-index.html#{{ f.id }}">Full evidence</a>.</li>{% else %}<li>No measured repair or ownership change was recorded.</li>{% endfor %}{% for item in p.reader.comparisonSummary %}<li>{{ item }}</li>{% endfor %}</ul>
<h2>What still needs checking</h2><ul>{% for row in p.reader.missingSummary %}<li><strong>{{ row.reason[:1]|upper }}{{ row.reason[1:] }}:</strong> {{ row.subjects|join("; ") }}.{% if row.explanation %} {{ row.explanation }}{% endif %}</li>{% else %}<li>Every required comparison has an accepted result.</li>{% endfor %}</ul>
<h2>Checks that found no problem</h2><ul>{% for item in p.reader.nullSummary %}<li>{{ item }}.</li>{% else %}<li>No completed no-finding check is recorded.</li>{% endfor %}</ul>
<h2>Reference information collected</h2><p>{% if p.reader.catalogueSummary %}{{ p.reader.catalogueSummary|join("; ") }}.{% else %}No catalogue-only result is recorded.{% endif %}</p>
<h2>Evidence and limits</h2><ul>{% for item in p.reader.get("otherLimits", []) %}<li>{{ item }}</li>{% endfor %}</ul><p>The <a href="evidence-index.html">evidence index</a> contains exact check names, setup identifiers, result codes, record keys, hashes, omitted rows, and provenance.</p></main></body></html>
