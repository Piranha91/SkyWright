{% set mn_ = ((p.get("reel") or {}).get("modNames") or {}) %}{% if mn_ %}<h2 id="reel-mod-names">Mod names in the review reel ({{ mn_|length }})</h2><p>Where each name the review reel speaks for a plugin's mod came from.</p><ul>{% for k, v in mn_|dictsort %}<li>{{ k }}: said as "{{ v.get("name") }}". {% if v.get("source") == "nexus-catalogue" %}Nexus page {{ v.get("nexusId") }}{% if v.get("fetched") %}, fetched for this reel{% endif %}.{% elif v.get("source") == "declared" %}Declared with --mod-name.{% else %}MO2 folder name: no Nexus name was found, because {{ v.get("reason") or "no reason was recorded" }}.{% endif %}</li>{% endfor %}</ul>{% endif %}
