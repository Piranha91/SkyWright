<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>viewprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <CharacterViewerRenderingPath Condition="'$(CharacterViewerRenderingPath)' == ''">..\..\..\SynthEBD\CharacterViewer.Rendering\CharacterViewer.Rendering.csproj</CharacterViewerRenderingPath>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\housecarl-core\housecarl-core.csproj" />
    <!-- CharacterViewer.Rendering lives in a SEPARATE repo. This was an absolute drive path, which
         built on exactly one machine. Default assumes the two repos are siblings; override with
         -p:CharacterViewerRenderingPath=... or the environment variable of the same name when they
         are not. It is also published as a NuGet package, so a consumer who does not want the
         source checkout can swap this ProjectReference for a PackageReference. -->
    <ProjectReference Include="$(CharacterViewerRenderingPath)" />
    <Compile Include="..\_shared\EnablePopulation.cs" Link="EnablePopulation.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\ConflictReport.cs" Link="ConflictReport.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\HarnessOrderCli.cs" Link="HarnessOrderCli.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\DetectorModel.cs" Link="DetectorModel.cs" />
    <Compile Include="..\_shared\Worklist.cs" Link="Worklist.cs" />
    <Compile Include="..\_shared\CollisionLayers.cs" Link="CollisionLayers.cs" />
    <Compile Include="..\_shared\CellBoundaryIndex.cs" Link="CellBoundaryIndex.cs" />
    <!-- The stations mode: the station rule, the XY to cell to water lookup, the pose file, and
         the floor plumbing every route probe already stands on. Compiled here so the mode calls
         the SAME code proofprobe's cases are on, rather than a restatement of it. -->
    <Compile Include="..\_shared\ActorBand.cs" Link="ActorBand.cs" />
    <Compile Include="..\_shared\FloorFeed.cs" Link="FloorFeed.cs" />
    <Compile Include="..\_shared\StationRule.cs" Link="StationRule.cs" />
    <Compile Include="..\_shared\PortalBoxOrientation.cs" Link="PortalBoxOrientation.cs" />
    <Compile Include="..\_shared\StationLookup.cs" Link="StationLookup.cs" />
    <Compile Include="..\_shared\StationGround.cs" Link="StationGround.cs" />
    <Compile Include="..\_shared\StationPoseFile.cs" Link="StationPoseFile.cs" />
    <Compile Include="..\_shared\NavCover.cs" Link="NavCover.cs" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <Compile Include="..\_shared\StateArm.cs" Link="StateArm.cs" />
  </ItemGroup>
</Project>
