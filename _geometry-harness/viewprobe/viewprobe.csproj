<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>viewprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <CharacterViewerRenderingPath Condition="'$(CharacterViewerRenderingPath)' == ''">..\..\..\SynthEBD\CharacterViewer.Rendering\CharacterViewer.Rendering.csproj</CharacterViewerRenderingPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\housecarl-core\housecarl-core.csproj" />
    <!-- CharacterViewer.Rendering lives in a SEPARATE repo. This was an absolute drive path, which
         built on exactly one machine. Default assumes the two repos are siblings; override with
         -p:CharacterViewerRenderingPath=... or the environment variable of the same name when they
         are not. It is also published as a NuGet package, so a consumer who does not want the
         source checkout can swap this ProjectReference for a PackageReference. -->
    <ProjectReference Include="$(CharacterViewerRenderingPath)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\ConflictReport.cs" Link="ConflictReport.cs" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
  </ItemGroup>
</Project>
