<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>viewprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <UseWPF>true</UseWPF>
    <!-- SkyRender.Character package version: SkyRenderVersion, set in Directory.Build.props. -->
    <!-- The top-down map camera (MapTiles.cs) exists from SkyRender 4.0; an older pin builds without it and says so. -->
    <DefineConstants Condition="!$(SkyRenderVersion.StartsWith('3.'))">$(DefineConstants);SKYRENDER_MAP_TILES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The conflict review workbench hosts the built scene through InteractiveViewer.Host. -->
    <InternalsVisibleTo Include="SkyWright" />
    <InternalsVisibleTo Include="workbench.tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\LastSighting.cs" Link="LastSighting.cs" />
    <Compile Include="..\_shared\MovedRefFixture.cs" Link="MovedRefFixture.cs" />
    <Compile Include="..\_shared\MovedRefSelfTest.cs" Link="MovedRefSelfTest.cs" />
    <Compile Include="..\_shared\MovedRefFloorCheck.cs" Link="MovedRefFloorCheck.cs" />
    <Compile Include="..\_shared\FloorReachFixture.cs" Link="FloorReachFixture.cs" />
    <Compile Include="..\_shared\BlockFixture.cs" Link="BlockFixture.cs" />
    <Compile Include="..\_shared\NifBoxFixture.cs" Link="NifBoxFixture.cs" />
    <Using Include="System.IO" />
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
    <!-- SkyRender.Character (which brings core SkyRender; viewprobe uses both) is the published
         NuGet package, restored from nuget.org. -->
    <PackageReference Include="SkyRender.Character" Version="$(SkyRenderVersion)" />
    <Compile Include="..\_shared\EnablePopulation.cs" Link="EnablePopulation.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\ConflictReport.cs" Link="ConflictReport.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\HarnessOrderCli.cs" Link="HarnessOrderCli.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\OrderMasters.cs" Link="OrderMasters.cs" />
    <Compile Include="..\_shared\DetectorModel.cs" Link="DetectorModel.cs" />
    <Compile Include="..\_shared\Worklist.cs" Link="Worklist.cs" />
    <Compile Include="..\_shared\CollisionLayers.cs" Link="CollisionLayers.cs" />
    <Compile Include="..\_shared\CellBoundaryIndex.cs" Link="CellBoundaryIndex.cs" />
    <Compile Include="..\_shared\BaseGamePlugins.cs" Link="BaseGamePlugins.cs" />
    <!-- The stations mode: the station rule, the XY to cell to water lookup, the pose file, and
         the floor plumbing every route probe already stands on. Compiled here so the mode calls
         the SAME code proofprobe's cases are on, rather than a restatement of it. -->
    <Compile Include="..\_shared\ActorBand.cs" Link="ActorBand.cs" />
    <Compile Include="..\_shared\FloorFeed.cs" Link="FloorFeed.cs" />
    <Compile Include="..\_shared\RingReach.cs" Link="RingReach.cs" />
    <Compile Include="..\_shared\LargeReferenceLists.cs" Link="LargeReferenceLists.cs" />
    <Compile Include="..\_shared\WinStateDump.cs" Link="WinStateDump.cs" />
    <Compile Include="..\_shared\StationRule.cs" Link="StationRule.cs" />
    <Compile Include="..\_shared\StationLookup.cs" Link="StationLookup.cs" />
    <Compile Include="..\_shared\StationGround.cs" Link="StationGround.cs" />
    <Compile Include="..\_shared\StationPoseFile.cs" Link="StationPoseFile.cs" />
    <Compile Include="..\_shared\NavCover.cs" Link="NavCover.cs" />
    <Compile Include="..\_shared\RouteStations.cs" Link="RouteStations.cs" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <Compile Include="..\_shared\StateArm.cs" Link="StateArm.cs" />
  </ItemGroup>
</Project>
