<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>patchprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\DiscoveryHits.cs" Link="DiscoveryHits.cs" />
    <Compile Include="..\_shared\ConflictReport.cs" Link="ConflictReport.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\OrderMasters.cs" Link="OrderMasters.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\DetectorModel.cs" Link="DetectorModel.cs" />
  </ItemGroup>
</Project>
