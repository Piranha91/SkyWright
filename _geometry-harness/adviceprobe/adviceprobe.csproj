<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>adviceprobe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HousecarlSrc)housecarl-core\housecarl-core.csproj" />
    <ProjectReference Include="$(SkyWrightSrc)SkyWright.Engine\SkyWright.Engine.csproj" />
    <!-- The shared Nexus transport and the persistent page catalogue (roadmap 4.21). This reference is why the
         probe no longer carries a copy of the ModDetail POST, and why a page the MCP server read is a page this
         probe already has: ONE store, ONE freshness rule. -->
    <ProjectReference Include="$(HousecarlSrc)housecarl-nexus\housecarl-nexus.csproj" />
    <Compile Include="..\_shared\HarnessTarget.cs" Link="HarnessTarget.cs" />
    <Compile Include="..\_shared\Configuration.cs" Link="Configuration.cs" />
    <Compile Include="..\_shared\SyntheticOrder.cs" Link="SyntheticOrder.cs" />
    <Compile Include="..\_shared\OrderMasters.cs" Link="OrderMasters.cs" />
    <Compile Include="..\_shared\OrderRules.cs" Link="OrderRules.cs" />
    <Compile Include="..\_shared\OrderAdvice.cs" Link="OrderAdvice.cs" />
  </ItemGroup>
</Project>
