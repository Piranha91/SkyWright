<Project Sdk="Microsoft.NET.Sdk">
  <!-- skywright-publish: builds an installed layout from a commit (see Program.cs). A developer tool; not installed itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>skywright-publish</AssemblyName>
    <RootNamespace>SkyWrightPublish</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\_shared\CheckoutLayout.cs" Link="CheckoutLayout.cs" />
  </ItemGroup>
</Project>
